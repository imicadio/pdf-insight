# ── Frontend (Vite, build time). Public — ends up in the JS bundle. ──
# Base URL of the backend (Vercel). Locally: `npx vercel dev` serves it on :3000.
VITE_API_URL=http://localhost:3000

# ── Backend (Vercel Function). Secrets — set in Vercel → Settings → Environment Variables. ──
ANTHROPIC_API_KEY=
# Optional, defaults to claude-opus-5-5
ANTHROPIC_MODEL=claude-opus-5-5
# Comma-separated list of origins allowed by CORS
ALLOWED_ORIGINS=https://imicadio.github.io,http://localhost:5173
# Optional: shared rate limiting in Upstash Redis. Without it each function instance keeps its own
# in-memory limits, and the Vercel Firewall rate-limit rule is the platform-wide layer.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
